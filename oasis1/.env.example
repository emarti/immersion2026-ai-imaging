# Copy this file to .env, then check DATA_RAW_PATH below (.env is gitignored, so each
# machine keeps its own path). See readme.md ("Before you start" / the run options).
#
# The DEFAULT below is the GitHub Codespaces path (the class default). If you run LOCALLY,
# change it to the folder that holds your extracted OASIS-1 discs -- the directory should
# contain one folder per disc: disc1/ disc2/ ... disc12/.
DATA_RAW_PATH=/workspaces/immersion2026-ai-imaging/data/
